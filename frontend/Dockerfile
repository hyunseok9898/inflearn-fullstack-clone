FROM node:20-alpine

RUN apk add --no-cache openssl && \
    ln -s /usr/lib/libssl.so.3 /usr/lib/libssl.so.1.1 && \
    ln -s /usr/lib/libcrypto.so.3 /usr/lib/libcrypto.so.1.1

RUN npm install -g pnpm

ARG CLOUDFRONT_DOMAIN
ARG NODE_ENV
ARG API_URL
ARG AUTH_SECRET
ARG DATABASE_URL
ARG NEXT_PUBLIC_PORTONE_STORE_ID
ARG NEXT_PUBLIC_PORTONE_CHANNEL_KEY
ARG NEXTAUTH_URL

ENV CLOUDFRONT_DOMAIN=$CLOUDFRONT_DOMAIN
ENV NODE_ENV=$NODE_ENV
ENV API_URL=$API_URL
ENV AUTH_SECRET=$AUTH_SECRET
ENV DATABASE_URL=$DATABASE_URL
ENV NEXT_PUBLIC_PORTONE_STORE_ID=$NEXT_PUBLIC_PORTONE_STORE_ID
ENV NEXT_PUBLIC_PORTONE_CHANNEL_KEY=$NEXT_PUBLIC_PORTONE_CHANNEL_KEY
ENV NEXTAUTH_URL=$NEXTAUTH_URL

WORKDIR /app

COPY package.json pnpm-lock.yaml ./

RUN pnpm install

COPY . .

ENV NODE_ENV=production

ARG CLOUDFRONT_DOMAIN
ENV CLOUDFRONT_DOMAIN=$CLOUDFRONT_DOMAIN

RUN pnpm prisma generate

RUN pnpm run build

EXPOSE 3000

CMD ["pnpm", "run", "start"]